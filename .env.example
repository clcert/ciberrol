# Copia este archivo a .env y ajusta los valores.

# Dirección que atiende Caddy.
#   ":80"              -> HTTP plano en cualquier IP. Úsalo en una red local o DETRÁS DE OTRO
#                         PROXY REVERSO que ya termina HTTPS (si pones un dominio aquí, Caddy
#                         redirige a HTTPS y se produce un bucle de redirecciones infinito).
#   "rol.midominio.cl" -> Caddy expuesto directo a internet: HTTPS automático con Let's Encrypt.
SITE_ADDRESS=:80

# Detrás de un proxy reverso: IPs/rangos del proxy en los que se confía para X-Forwarded-*.
# "private_ranges" cubre redes privadas (proxy en el mismo servidor o en la LAN).
# Si el proxy tiene IP pública, ponla aquí (p. ej. "203.0.113.10/32"), separando varias con espacios.
TRUSTED_PROXIES=private_ranges

# URL pública que se muestra en el QR (p. ej. http://192.168.1.50 o https://rol.midominio.cl).
# Si se deja vacía se usa la dirección con la que el admin abrió la página.
PUBLIC_URL=

# Pon "true" si sirves la app por HTTPS (cookies solo por HTTPS).
COOKIE_SECURE=false

POSTGRES_DB=ciberrol
POSTGRES_USER=ciberrol
POSTGRES_PASSWORD=cambia-esta-clave
